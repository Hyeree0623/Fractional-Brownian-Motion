        args.axis = 0
        args.min_coverage = 0.95
        args.use_unwrapped = True
        args.unwrap_if_needed = True
        args.max_lag = None
        args.H_ref = None
        args.delta = 0.1
        args.m_values = "1,2,4,8,16,32,64,128"
        args.out = "pvariation_three_H.pdf"
        run(args)
    else:
        parser = argparse.ArgumentParser(description="Plot V_m^(p) vs m for H ± delta, p=1/H")
        parser.add_argument("dump", help="Path to LAMMPS dump file")
        parser.add_argument("--dims", type=int, default=2, choices=[2,3])
        parser.add_argument("--axis", type=int, default=0)
        parser.add_argument("--min_coverage", type=float, default=0.95)
        parser.add_argument("--use_unwrapped", action="store_true")
        parser.add_argument("--unwrap_if_needed", action="store_true")
        parser.add_argument("--max_lag", type=int, default=None)
        parser.add_argument("--H_ref", type=float, default=None)
        parser.add_argument("--delta", type=float, default=0.1)
        parser.add_argument("--m_values", type=str, default="1,2,4,8,16,32,64,128")
        parser.add_argument("--out", type=str, default="pvariation_three_H.pdf")
        args = parser.parse_args()
        run(args)
